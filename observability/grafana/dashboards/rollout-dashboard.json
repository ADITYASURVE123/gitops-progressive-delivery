{
  "dashboard": {
    "title": "Progressive Delivery Dashboard",
    "description": "Real-time monitoring of GitOps progressive delivery rollouts",
    "tags": ["gitops", "progressive-delivery", "argo-rollouts"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Rollout Status",
        "type": "stat",
        "gridPos": {"h": 3, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "argocd_rollouts_rollout_status{name=\"api-rollout-canary\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "Healthy"}}, "type": "value"},
              {"options": {"1": {"text": "Progressing"}}, "type": "value"},
              {"options": {"2": {"text": "Degraded"}}, "type": "value"},
              {"options": {"3": {"text": "Aborted"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Traffic Split",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 3},
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"api-service\", version=\"stable\"}[5m])",
            "legendFormat": "Stable",
            "refId": "A"
          },
          {
            "expr": "rate(http_requests_total{service=\"api-service\", version=\"canary\"}[5m])",
            "legendFormat": "Canary",
            "refId": "B"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 9},
        "targets": [
          {
            "expr": "rate(http_requests_errors_total{service=\"api-service\"}[5m])",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Latency p99",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 15},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"api-service\"}[5m]))",
            "legendFormat": "p99 Latency",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Analysis Runs",
        "type": "table",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 21},
        "targets": [
          {
            "expr": "argocd_analysis_run_status{template=\"metric-analysis\"}",
            "legendFormat": "Analysis Run",
            "refId": "A"
          }
        ]
      }
    ]
  }
}